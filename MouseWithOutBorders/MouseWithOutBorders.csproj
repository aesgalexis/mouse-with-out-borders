<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>0.1.6</Version>
    <AssemblyName>MouseWithOutBorders</AssemblyName>
    <RootNamespace>MouseWithOutBorders</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\app.ico" LogicalName="MouseWithOutBorders.AppIcon.ico" />
  </ItemGroup>
  <Target Name="GenerateIcon" BeforeTargets="PrepareForBuild"
          Condition="'$(OS)' == 'Windows_NT'"
          Inputs="$(MSBuildProjectDirectory)\assets\app.svg;$(MSBuildProjectDirectory)\..\scripts\generate-icon.ps1"
          Outputs="$(MSBuildProjectDirectory)\assets\app.ico">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\generate-icon.ps1&quot; &quot;$(MSBuildProjectDirectory)\assets\app.ico&quot;" />
  </Target>
</Project>
